{
  "opencollection": "1.0.0",
  "info": {
    "name": "TMS OnConnect Celebrities Social API",
    "version": "1.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Social",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Social Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://data.tmsapi.com/social/:rootId_seriesId",
            "params": [
              {
                "name": "rootId_seriesId",
                "value": "",
                "type": "path",
                "description": "Root ID or series ID"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Obtains social media links for a movie or TV series."
        }
      ]
    }
  ],
  "bundled": true
}