{
  "opencollection": "1.0.0",
  "info": {
    "name": "TMS OnConnect Celebrities Movies API",
    "version": "1.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Movies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Movies Airing on TV",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://data.tmsapi.com/v1.1/movies/airings",
            "params": [
              {
                "name": "lineupId",
                "value": "",
                "type": "query"
              },
              {
                "name": "startDateTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDateTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeAdult",
                "value": "",
                "type": "query"
              },
              {
                "name": "imageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "imageText",
                "value": "",
                "type": "query"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Provides movies airing on a lineup (up to 24 hours, 14 days advance)."
        },
        {
          "info": {
            "name": "Get Movies in Theatres",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://data.tmsapi.com/v1.1/movies/showings",
            "params": [
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "numDays",
                "value": "",
                "type": "query"
              },
              {
                "name": "zip",
                "value": "",
                "type": "query"
              },
              {
                "name": "lat",
                "value": "",
                "type": "query"
              },
              {
                "name": "lng",
                "value": "",
                "type": "query"
              },
              {
                "name": "radius",
                "value": "",
                "type": "query"
              },
              {
                "name": "units",
                "value": "",
                "type": "query"
              },
              {
                "name": "imageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "market",
                "value": "",
                "type": "query"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns movies currently playing in local theatres with showtimes."
        },
        {
          "info": {
            "name": "Get Movie Showtimes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://data.tmsapi.com/v1.1/movies/:movieId/showings",
            "params": [
              {
                "name": "movieId",
                "value": "",
                "type": "path"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "numDays",
                "value": "",
                "type": "query"
              },
              {
                "name": "zip",
                "value": "",
                "type": "query"
              },
              {
                "name": "lat",
                "value": "",
                "type": "query"
              },
              {
                "name": "lng",
                "value": "",
                "type": "query"
              },
              {
                "name": "radius",
                "value": "",
                "type": "query"
              },
              {
                "name": "units",
                "value": "",
                "type": "query"
              },
              {
                "name": "imageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns metadata and theatre/showtime information for a specific movie."
        }
      ]
    }
  ],
  "bundled": true
}